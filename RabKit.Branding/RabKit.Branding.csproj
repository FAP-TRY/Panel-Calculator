<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RabKit.Branding — engine-side branding abstraction.

    Target net8.0 (NOT net8.0-windows): the contract surface is pure POCO
    interfaces + records + hex-string color tokens — no Windows-specific
    types are referenced. This lets the cross-platform PanelCalculator.Data
    project (which depends on us for the machine-key pepper) keep its
    net8.0 TFM without dragging in WinForms transitively.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release builds: no PDB shipped. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Ed25519 signature verification for the signed edition.manifest.bundle.
      Pinned at 24.4.0 — same version used by PanelCalculator.Core for the
      license signer/verifier, so the EXE only ships ONE NSec runtime.
    -->
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose EditionContext.ResetForTests + BrandContext.ResetForTests to tests. -->
    <InternalsVisibleTo Include="PanelCalculator.Tests" />
  </ItemGroup>

</Project>
