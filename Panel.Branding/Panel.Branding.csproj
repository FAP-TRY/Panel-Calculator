<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Panel.Branding — vertical pack for the existing PT TTS panel-listrik
    install. Holds every hardcoded TTS value that used to live scattered
    across the source tree (signer, NPWP, GitHub coords, license public
    key, machine-key pepper) plus the panel-industry section vocab + the
    MCB/MCCB family heuristic. Branding assets (letterhead, signature,
    stamp, logo) are embedded resources of THIS DLL — the engine reads
    them through IBrandConfig byte accessors, no GetManifestResourceStream
    of the WinForms assembly.
  -->
  <!--
    Target net8.0 (NOT net8.0-windows): this pack only ships POCO config
    values + embedded image bytes — no Windows-specific types. Matches
    RabKit.Branding's TFM so PanelCalculator.Data (cross-platform) can
    depend on us for the machine-key pepper without dragging in WinForms.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release builds: no PDB shipped. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" />
    <EmbeddedResource Include="Assets\letterhead.jpg" />
    <EmbeddedResource Include="Assets\signature.png" />
    <EmbeddedResource Include="Assets\stamp.png" />
    <!--
      Signed edition manifest (4-byte BE length + JSON + 64-byte Ed25519
      signature). Generated offline via Tools\sign-edition-manifest.ps1.
      The signing private key never enters the repo. Loaded at startup via
      SignedManifestLoader.LoadAndVerifyFromBundle in Program.Main.
    -->
    <EmbeddedResource Include="Assets\edition.manifest.bundle" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RabKit.Branding\RabKit.Branding.csproj" />
  </ItemGroup>

</Project>
