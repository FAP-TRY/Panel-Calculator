<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows agar bisa reference PanelCalculator.WinForms.csproj
         (yang juga net8.0-windows). Tests dengan target net8.0 saja tidak
         dapat mereferensikan TargetFramework "windows" karena cross-target. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UseWindowsForms ditambahkan supaya transitive deps WinForms (System.Drawing, dll) tersedia. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.1" />
    <!-- SQLite + plain provider for ProductsIndexMigrator tests. The Data
         project uses the SQLCipher bundle which requires a key for every open;
         pulling in the plain bundle here keeps unit tests simple. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanelCalculator.Core\PanelCalculator.Core.csproj" />
    <ProjectReference Include="..\PanelCalculator.Data\PanelCalculator.Data.csproj" />
    <!-- Reference ke WinForms supaya bisa test WordLetterExport & ExcelLetterExport
         (services di WinForms project). Tests project sekarang net8.0-windows
         agar cross-target consistent. -->
    <ProjectReference Include="..\PanelCalculator.WinForms\PanelCalculator.WinForms.csproj" />
    <!-- Branding contracts + Panel pack — golden master tests assert that
         BrandContext.Current returns PT TTS values, and that the WinForms
         BrandContext.Initialize wiring lines up with what the export
         services expect. -->
    <ProjectReference Include="..\RabKit.Branding\RabKit.Branding.csproj" />
    <ProjectReference Include="..\Panel.Branding\Panel.Branding.csproj" />
  </ItemGroup>

</Project>
