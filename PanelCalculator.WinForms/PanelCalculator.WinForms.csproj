<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Release builds: no PDB shipped (reverse-engineering harder, EXE lebih kecil). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    W2.6: Embedded resource untuk branding (logo, letterhead, signature,
    stamp) sudah dipindah ke Panel.Branding/Assets/. Export services dan
    UI forms sekarang baca via BrandContext.Current.GetLogoBytes() /
    .GetLetterheadBytes() / .GetSignatureBytes() / .GetStampBytes().
    Tidak ada lagi <EmbeddedResource> branding di project WinForms.
  -->

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocX" Version="4.0.25103.5784" />
    <PackageReference Include="itext7" Version="7.2.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanelCalculator.Core\PanelCalculator.Core.csproj" />
    <ProjectReference Include="..\PanelCalculator.Data\PanelCalculator.Data.csproj" />
    <ProjectReference Include="..\RabKit.Branding\RabKit.Branding.csproj" />
    <ProjectReference Include="..\Panel.Branding\Panel.Branding.csproj" />
  </ItemGroup>

</Project>
